# 32. Итоговая функция оценки правила

Используй единый evaluator для всех кандидатов.

```python
import math


def evaluate_counts(tp, fp, n_fraud, n_good):
    fn = n_fraud - tp
    tn = n_good - fp

    tpr = tp / n_fraud if n_fraud else 0.0
    fpr = fp / n_good if n_good else 0.0
    specificity = 1.0 - fpr

    tpr_low, tpr_high = wilson_interval(tp, n_fraud)
    fpr_low, fpr_high = wilson_interval(fp, n_good)

    separation = (
        tpr / fpr
        if fpr > 0
        else math.inf
    )

    conservative_separation = (
        tpr_low / fpr_high
        if fpr_high > 0
        else math.inf
    )

    return {
        "tp": tp,
        "fp": fp,
        "fn": fn,
        "tn": tn,
        "tpr": tpr,
        "fpr": fpr,
        "specificity": specificity,
        "separation": separation,
        "tpr_low": tpr_low,
        "tpr_high": tpr_high,
        "fpr_low": fpr_low,
        "fpr_high": fpr_high,
        "conservative_separation": conservative_separation,
    }
```

Все генераторы кандидатов должны передавать правила в этот evaluator.

