)


print("\nСобытия:")
display(
    events.head(10)
)


print("\nГотовые признаки:")
display(
    existing.head(10)
)


# ============================================================
# 4. СЧИТАЕМ НОВЫЕ ПРИЗНАКИ ИЗ СОБЫТИЙ
#
# В реальной задаче это как раз то место,
# где будут десятки миллионов строк.
#
# Но после этого этапа события нам для поиска
# правил больше не нужны.
# ============================================================

events_with_time = (

    events

    .join(
        existing.select([
            "epk_id",
            "reference_time",
        ]),
        on="epk_id",
        how="left",
    )

    .with_columns(

        (
            pl.col("reference_time")
            - pl.col("event_time")
        )
        .dt.total_minutes()
        .alias("minutes_ago")

    )
)


display(
    events_with_time.head()
)


# ============================================================
# 5. АГРЕГИРОВАННЫЕ ПРИЗНАКИ
# ============================================================

new_features = (

    events_with_time

    .group_by(
        "epk_id"
    )

    .agg([

        # ----------------------------------------------------
        # Входы
        # ----------------------------------------------------

        (
            (
                (pl.col("event_type") == "LOGIN")
                &
                (pl.col("minutes_ago") <= 10)
            )
            .cast(pl.UInt16)
            .sum()
        )
        .alias(
            "login_count_10m"
        ),


        (
            (
                (pl.col("event_type") == "LOGIN")
                &
                (pl.col("minutes_ago") <= 30)
            )
            .cast(pl.UInt16)
            .sum()
        )
        .alias(
            "login_count_30m"
        ),


        (
            (
                (pl.col("event_type") == "LOGIN")
                &
                (pl.col("minutes_ago") <= 60)
            )
            .cast(pl.UInt16)
            .sum()
        )
        .alias(
            "login_count_1h"
        ),


        # ----------------------------------------------------
        # EPOS
        # ----------------------------------------------------

        (
            (
                (pl.col("event_type") == "EPOS")
                &
                (pl.col("minutes_ago") <= 60)
            )
            .cast(pl.UInt16)
            .sum()
        )
        .alias(
            "epos_count_1h"
        ),


        # ----------------------------------------------------
        # POS
        # ----------------------------------------------------

        (
            (
                (pl.col("event_type") == "POS")
                &
                (pl.col("minutes_ago") <= 60)
            )
            .cast(pl.UInt16)
            .sum()
        )
        .alias(
            "pos_count_1h"
        ),


        # ----------------------------------------------------
        # Сколько разных типов событий было за час
        # ----------------------------------------------------

        (
            pl.col("event_type")

            .filter(
                pl.col("minutes_ago")
                <= 60
            )

            .n_unique()
        )
        .alias(
            "unique_event_types_1h"
        ),


        # ----------------------------------------------------
        # Сколько минут прошло
        # с последнего входа
        # ----------------------------------------------------

        (
            pl.col("minutes_ago")

            .filter(
                pl.col("event_type")
                == "LOGIN"
            )

            .min()
        )
        .alias(
            "minutes_since_login"
        ),

    ])
)


print(
    "\nНовые признаки:"
)

display(
    new_features.head(10)
)


# ============================================================
# 6. ОБЪЕДИНЯЕМ
#
# СЛЕВА:
# готовые ~100 признаков коллег
#
# СПРАВА:
# новые признаки из событий
# ============================================================

features = (

    existing

    .join(
        new_features,
        on="epk_id",
        how="left",
    )

    .fill_null(0)
)


print(
    "\nИтоговая таблица:"
)

display(
    features.head()
)


# ============================================================
# 7. УКАЗЫВАЕМ, ОТКУДА КАЖДЫЙ ПРИЗНАК
#
# Это позволит потом понять:
#
# правило состоит:
#
# - только из готовых признаков
# - только из новых
# - смешанное
# ============================================================

EXISTING_FEATURES = [

    "device_change_24h",

    "transfer_count_1h",

    "amount_sum_1h",

    "client_age_days",

    "risk_score",
]


NEW_FEATURES = [

    "login_count_10m",

    "login_count_30m",

    "login_count_1h",

    "epos_count_1h",

    "pos_count_1h",

    "unique_event_types_1h",

    "minutes_since_login",
]


ALL_FEATURES = (
    EXISTING_FEATURES
    +
    NEW_FEATURES
)


FEATURE_SOURCE = {

    **{
        feature: "готовый"
        for feature
        in EXISTING_FEATURES
    },

    **{
        feature: "новый"
        for feature
        in NEW_FEATURES
    },
}


# ============================================================
# 8. ПЕРЕВОДИМ МАЛЕНЬКУЮ ТАБЛИЦУ В PANDAS
#
# ВАЖНО:
#
# Мы НЕ переводим 100 млн событий.
#
# Только уже готовую таблицу признаков:
#
# 1 клиент = 1 строка
# ============================================================

df = features.select(

    [
        "epk_id",
        "target",
    ]
    +
    ALL_FEATURES

).to_pandas()


print(
    df.shape
)


# ============================================================
# 9. ДЕЛИМ ДАННЫЕ
#
# Часть данных:
# ищем правила
#
# Другая часть:
# честно проверяем найденные правила
#
# В реальном антифроде лучше разделять ПО ВРЕМЕНИ.
#
# Например:
#
# январь-март -> поиск
# апрель      -> проверка
# ============================================================

search_idx, check_idx = train_test_split(

    np.arange(
        len(df)
    ),

    test_size=0.30,

    stratify=df["target"],

    random_state=RANDOM_STATE,
)


search_df = (
    df
    .iloc[search_idx]
    .reset_index(drop=True)
)

check_df = (
    df
    .iloc[check_idx]
    .reset_index(drop=True)
)


print(
    "Для поиска:",
    len(search_df)
)

print(
    "Для проверки:",
    len(check_df)
)


# ============================================================
# 10. УМЕНЬШАЕМ GOOD ТОЛЬКО НА ЭТАПЕ ПОИСКА
#
# Например:
#
# 3000 fraud
# +
# 30 000 good
#
# вместо:
#
# 3000 fraud
# +
# 2 000 000 good
#
# Это сильно ускоряет поиск.
#
# НО:
#
# финальную проверку делаем на настоящем распределении.
# ============================================================

fraud_search = (
    search_df[
        search_df["target"] == 1
    ]
)


good_search = (
    search_df[
        search_df["target"] == 0
    ]
)


N_GOOD_PER_FRAUD = 10


good_sample_size = min(

    len(good_search),

    len(fraud_search)
    * N_GOOD_PER_FRAUD,
)


good_search_sample = (

    good_search

    .sample(
        n=good_sample_size,
        random_state=RANDOM_STATE,
    )
)


rule_search_df = pd.concat([

    fraud_search,

    good_search_sample,

])


rule_search_df = (

    rule_search_df

    .sample(
        frac=1,
        random_state=RANDOM_STATE,
    )

    .reset_index(
        drop=True
    )
)


print(
    "\nПоиск правил:"
)

print(
    "Fraud:",
    (
        rule_search_df["target"]
        == 1
    ).sum()
)

print(
    "Good:",
    (
        rule_search_df["target"]
        == 0
    ).sum()
)


# ============================================================
# 11. СТРОИМ МНОГО МАЛЕНЬКИХ ДЕРЕВЬЕВ
#
# max_depth = 3
#
# означает:
#
# правило будет максимум примерно из 3 условий.
#
# Например:
#
# login_count_30m >= 4
# AND
# device_change_24h >= 1
# AND
# transfer_count_1h >= 2
#
# Это очень удобно для SQL.
# ============================================================

model = RandomForestClassifier(

    # Количество маленьких деревьев.
    n_estimators=100,

    # Максимум 3 условия в пути.
    max_depth=3,

    # Не строим правила
    # по 1-2 клиентам.
    min_samples_leaf=20,

    # Балансируем Fraud / Good.
    class_weight=
        "balanced_subsample",

    # На каждом разделении
    # смотрим не обязательно
    # все признаки.
    max_features=0.8,

    n_jobs=-1,

    random_state=
        RANDOM_STATE,
)


model.fit(

    rule_search_df[
        ALL_FEATURES
    ],

    rule_search_df[
        "target"
    ],
)


print(
    "\nДеревья обучены"
)


# ============================================================
# 12. ИЗВЛЕКАЕМ ПРАВИЛА ИЗ ДЕРЕВЬЕВ
#
# Дерево:
#
# login_count_30m > 3.5
#       |
# device_change_24h > 0.5
#       |
# transfer_count_1h > 1.5
#
# превращаем в:
#
# login_count_30m >= 4
# AND
# device_change_24h >= 1
# AND
# transfer_count_1h >= 2
# ============================================================

def extract_rules_from_tree(
    estimator,
    feature_names,
):

    tree = estimator.tree_

    classes = (
        estimator.classes_
    )

    rules = []


    def walk(
        node,
        conditions,
    ):

        left = (
            tree.children_left[
                node
            ]
        )

        right = (
            tree.children_right[
                node
            ]
        )


        # ----------------------------------------------------
        # Лист дерева
        # ----------------------------------------------------

        if left == right:

            values = (
                tree.value[
                    node
                ][0]
            )

            predicted_class = (

                classes[

                    int(
                        np.argmax(
                            values
                        )
                    )

                ]

            )


            # Нас интересуют
            # только fraud-листья.
            if predicted_class == 1:

                rules.append(
                    list(
                        conditions
                    )
                )

            return


        feature_index = (
            tree.feature[
                node
            ]
        )

        feature_name = (
            feature_names[
                feature_index
            ]
        )

        threshold = float(

            tree.threshold[
                node
            ]

        )


        # Левая ветка:
        #
        # feature <= threshold

        walk(

            left,

            conditions
            +
            [
                (
                    feature_name,
                    "<=",
                    threshold,
                )
            ],
        )


        # Правая ветка:
        #
        # feature > threshold

        walk(

            right,

            conditions
            +
            [
                (
                    feature_name,
                    ">",
                    threshold,
                )
            ],
        )


    walk(
        0,
        [],
    )


    return rules


# ============================================================
# 13. СОБИРАЕМ ПРАВИЛА СО ВСЕХ ДЕРЕВЬЕВ
# ============================================================

candidate_rules = []


for estimator in model.estimators_:

    tree_rules = (
        extract_rules_from_tree(

            estimator,

            ALL_FEATURES,
        )
    )

    candidate_rules.extend(
        tree_rules
    )


print(
    "Правил до удаления дублей:",
    len(candidate_rules),
)


# ============================================================
# 14. УДАЛЯЕМ ОДИНАКОВЫЕ ПРАВИЛА
# ============================================================

def rule_key(rule):

    return tuple(

        (
            feature,
            operation,
            round(
                threshold,
                6,
            ),
        )

        for (
            feature,
            operation,
            threshold
        )

        in rule
    )


unique_rules = {}


for rule in candidate_rules:

    unique_rules[
        rule_key(rule)
    ] = rule


candidate_rules = list(
    unique_rules.values()
)


print(
    "Уникальных правил:",
    len(candidate_rules),
)


# ============================================================
# 15. ФУНКЦИЯ:
# ПРИМЕНИТЬ ПРАВИЛО К ТАБЛИЦЕ
#
# Это уже НЕ Python-цикл по клиентам.
#
# Все строки проверяются сразу.
# ============================================================

def apply_rule(
    dataframe,
    rule,
):

    mask = np.ones(

        len(dataframe),

        dtype=bool,
    )


    for (
        feature,
        operation,
        threshold
    ) in rule:

        values = (
            dataframe[
                feature
            ]
            .to_numpy()
        )


        if operation == "<=":

            mask &= (
                values
                <= threshold
            )

        else:

            mask &= (
                values
                > threshold
            )


    return mask


# ============================================================
# 16. ПРЕДСТАВИМ,
# ЧТО У НАС УЖЕ ЕСТЬ БОЕВОЕ ПРАВИЛО
#
# Например:
#
# device_change_24h >= 1
# AND
# transfer_count_1h >= 3
#
# Оно нужно, чтобы понять:
#
# новый кандидат ловит НОВЫЙ fraud
#
# или просто повторяет существующие правила.
# ============================================================

existing_rule_mask = (

    (
        check_df[
            "device_change_24h"
        ]
        >= 1
    )

    &

    (
        check_df[
            "transfer_count_1h"
        ]
        >= 3
    )

).to_numpy()


# ============================================================
# 17. ОЦЕНКА ОДНОГО ПРАВИЛА
# ============================================================

def evaluate_rule(
    dataframe,
    rule,
    existing_rules_mask=None,
):

    rule_mask = apply_rule(
        dataframe,
        rule,
    )


    target = (
        dataframe[
            "target"
        ]
        .to_numpy()
        .astype(bool)
    )


    fraud_mask = target

    good_mask = ~target


    # --------------------------------------------------------
    # Fraud, которых поймали
    # --------------------------------------------------------

    tp = int(
        (
            rule_mask
            &
            fraud_mask
        )
        .sum()
    )


    # --------------------------------------------------------
    # Нормальные клиенты,
    # которых задели
    # --------------------------------------------------------

    fp = int(
        (
            rule_mask
            &
            good_mask
        )
        .sum()
    )


    fraud_total = int(
        fraud_mask.sum()
    )

    good_total = int(
        good_mask.sum()
    )


    # --------------------------------------------------------
    # Recall
    #
    # Какая доля всего fraud
    # была поймана.
    # --------------------------------------------------------

    recall = (

        tp / fraud_total

        if fraud_total

        else 0
    )


    # --------------------------------------------------------
    # Precision
    #
    # Среди всех срабатываний
    # какая доля fraud.
    # --------------------------------------------------------

    precision = (

        tp / (tp + fp)

        if (tp + fp)

        else 0
    )


    # --------------------------------------------------------
    # Как часто правило срабатывает
    # на fraud.
    # --------------------------------------------------------

    fraud_trigger_rate = (

        tp / fraud_total

        if fraud_total

        else 0
    )


    # --------------------------------------------------------
    # Как часто правило срабатывает
    # на good.
    # --------------------------------------------------------

    good_trigger_rate = (

        fp / good_total

        if good_total

        else 0
    )


    # --------------------------------------------------------
    # Lift
    #
    # Во сколько раз правило
    # чаще срабатывает на Fraud,
    # чем на Good.
    # --------------------------------------------------------

    lift = (

        fraud_trigger_rate
        /
        good_trigger_rate

        if good_trigger_rate > 0

        else float("inf")
    )


    trigger_count = int(
        rule_mask.sum()
    )


    trigger_rate = (

        trigger_count
        /
        len(dataframe)

    )


    # --------------------------------------------------------
    # НОВЫЙ FRAUD
    #
    # Убираем всё,
    # что уже ловят текущие правила.
    # --------------------------------------------------------

    incremental_tp = None
    incremental_fp = None


    if existing_rules_mask is not None:

        new_mask = (

            rule_mask

            &

            ~existing_rules_mask
        )


        incremental_tp = int(

            (
                new_mask
                &
                fraud_mask
            )
            .sum()

        )


        incremental_fp = int(

            (
                new_mask
                &
                good_mask
            )
            .sum()

        )


    return {

        "tp": tp,

        "fp": fp,

        "recall": recall,

        "precision": precision,

        "lift": lift,

        "trigger_count":
            trigger_count,

        "trigger_rate":
            trigger_rate,

        "incremental_tp":
            incremental_tp,

        "incremental_fp":
            incremental_fp,
    }


# ============================================================
# 18. ПОНЯТНЫЙ ВИД УСЛОВИЙ
#
# У дерева могут быть пороги:
#
# login_count_30m > 3.5
#
# Для целочисленного признака это означает:
#
# login_count_30m >= 4
# ============================================================

INTEGER_FEATURES = {

    "device_change_24h",

    "transfer_count_1h",

    "client_age_days",

    "login_count_10m",

    "login_count_30m",

    "login_count_1h",

    "epos_count_1h",

    "pos_count_1h",

    "unique_event_types_1h",

    "minutes_since_login",
}


def format_condition(
    feature,
    operation,
    threshold,
):

    # --------------------------------------------------------
    # Целочисленные признаки
    # --------------------------------------------------------

    if feature in INTEGER_FEATURES:

        if operation == "<=":

            value = math.floor(
                threshold
            )

            return (
                f"{feature} <= {value}"
            )

        else:

            value = (
                math.floor(
                    threshold
                )
                + 1
            )

            return (
                f"{feature} >= {value}"
            )


    # --------------------------------------------------------
    # Числовые непрерывные признаки
    # --------------------------------------------------------

    value = round(
        threshold,
        4,
    )


    if operation == "<=":

        return (
            f"{feature} <= {value}"
        )

    return (
        f"{feature} > {value}"
    )


def rule_to_text(rule):

    return " AND ".join(

        format_condition(
            feature,
            operation,
            threshold,
        )

        for (
            feature,
            operation,
            threshold
        )

        in rule
    )


# ============================================================
# 19. SQL
# ============================================================

def rule_to_sql(rule):

    conditions = [

        format_condition(
            feature,
            operation,
            threshold,
        )

        for (
            feature,
            operation,
            threshold
        )

        in rule
    ]


    sql = (

        "CASE\n"
        "    WHEN "

        +

        "\n     AND ".join(
            conditions
        )

        +

        "\n    THEN 1\n"
        "    ELSE 0\n"
        "END"
    )


    return sql


