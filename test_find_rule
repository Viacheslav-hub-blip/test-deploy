# ============================================================
# 0. ИМПОРТЫ
# ============================================================

import math
from datetime import datetime, timedelta

import numpy as np
import pandas as pd
import polars as pl

from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import train_test_split


# ============================================================
# 1. НАСТРОЙКИ
# ============================================================

RANDOM_STATE = 42
rng = np.random.default_rng(RANDOM_STATE)

# Для теста создадим 15 000 клиентов.
N_CLIENTS = 15_000

# Момент, в который мы хотим принять решение:
#
# "Срабатывать сейчас или нет?"
#
# В реальных данных у каждого клиента reference_time
# может быть своим.
REFERENCE_TIME = datetime(
    2026, 10, 1, 12, 0, 0
)


# ============================================================
# 2. СОЗДАЁМ ТЕСТОВЫЕ ДАННЫЕ
#
# ЭТОТ БЛОК НУЖЕН ТОЛЬКО ДЛЯ ДЕМОНСТРАЦИИ.
#
# Когда будешь работать со своими данными,
# этот блок просто удаляется.
# ============================================================

events_rows = []
existing_rows = []


for epk_id in range(N_CLIENTS):

    # --------------------------------------------------------
    # ГОТОВЫЕ ПРИЗНАКИ
    #
    # Представим, что эти признаки уже рассчитали коллеги.
    # --------------------------------------------------------

    device_change_24h = rng.binomial(
        1,
        0.08,
    )

    transfer_count_1h = rng.poisson(
        0.7
    )

    client_age_days = rng.integers(
        10,
        3000,
    )

    risk_score = rng.beta(
        2,
        8,
    )


    # --------------------------------------------------------
    # СОБЫТИЯ
    #
    # Эти значения специально НЕ кладём
    # в готовые признаки.
    #
    # Потом восстановим их из истории событий.
    # --------------------------------------------------------

    login_count_30m = rng.poisson(
        1.5
    )

    old_login_count = rng.poisson(
        2.0
    )

    epos_count_1h = rng.poisson(
        0.8
    )

    pos_count_1h = rng.poisson(
        0.7
    )


    # --------------------------------------------------------
    # LOGIN за последние 30 минут
    # --------------------------------------------------------

    for _ in range(login_count_30m):

        minutes_ago = rng.integers(
            1,
            31,
        )

        events_rows.append({
            "epk_id": epk_id,

            "event_time":
                REFERENCE_TIME
                - timedelta(
                    minutes=int(minutes_ago)
                ),

            "event_type": "LOGIN",

            "amount": 0.0,
        })


    # --------------------------------------------------------
    # Старые LOGIN:
    # от 30 минут до суток назад
    # --------------------------------------------------------

    for _ in range(old_login_count):

        minutes_ago = rng.integers(
            31,
            1441,
        )

        events_rows.append({
            "epk_id": epk_id,

            "event_time":
                REFERENCE_TIME
                - timedelta(
                    minutes=int(minutes_ago)
                ),

            "event_type": "LOGIN",

            "amount": 0.0,
        })


    # --------------------------------------------------------
    # EPOS
    # --------------------------------------------------------

    for _ in range(epos_count_1h):

        minutes_ago = rng.integers(
            1,
            61,
        )

        amount = float(
            rng.gamma(
                1.5,
                3000,
            )
        )

        events_rows.append({
            "epk_id": epk_id,

            "event_time":
                REFERENCE_TIME
                - timedelta(
                    minutes=int(minutes_ago)
                ),

            "event_type": "EPOS",

            "amount": amount,
        })


    # --------------------------------------------------------
    # POS
    # --------------------------------------------------------

    for _ in range(pos_count_1h):

        minutes_ago = rng.integers(
            1,
            61,
        )

        amount = float(
            rng.gamma(
                1.5,
                5000,
            )
        )

        events_rows.append({
            "epk_id": epk_id,

            "event_time":
                REFERENCE_TIME
                - timedelta(
                    minutes=int(minutes_ago)
                ),

            "event_type": "POS",

            "amount": amount,
        })


    # --------------------------------------------------------
    # TRANSFER
    # --------------------------------------------------------

    transfer_amounts = []

    for _ in range(transfer_count_1h):

        minutes_ago = rng.integers(
            1,
            61,
        )

        amount = float(
            rng.gamma(
                1.8,
                35_000,
            )
        )

        transfer_amounts.append(
            amount
        )

        events_rows.append({
            "epk_id": epk_id,

            "event_time":
                REFERENCE_TIME
                - timedelta(
                    minutes=int(minutes_ago)
                ),

            "event_type": "TRANSFER",

            "amount": amount,
        })


    amount_sum_1h = sum(
        transfer_amounts
    )


    # ========================================================
    # СОЗДАЁМ ИСКУССТВЕННЫЙ FRAUD
    #
    # Это нужно только для демонстрации.
    #
    # Специально создадим скрытую закономерность:
    #
    # 1)
    # смена устройства
    # +
    # >= 2 переводов
    # +
    # >= 4 входов за 30 минут
    #
    # ИЛИ
    #
    # 2)
    # >= 5 входов
    # +
    # переводов более чем на 90 000
    #
    # ИЛИ
    #
    # 3)
    # >= 3 EPOS
    # +
    # >= 4 входов
    #
    # Деревья потом должны попытаться это найти.
    # ========================================================

    fraud_pattern = (

        (
            device_change_24h >= 1
            and transfer_count_1h >= 2
            and login_count_30m >= 4
        )

        or

        (
            login_count_30m >= 5
            and amount_sum_1h > 90_000
        )

        or

        (
            epos_count_1h >= 3
            and login_count_30m >= 4
        )
    )


    # Базовая вероятность fraud.
    fraud_probability = 0.005


    if fraud_pattern:
        fraud_probability += 0.45


    if risk_score > 0.5:
        fraud_probability += 0.05


    if transfer_count_1h >= 4:
        fraud_probability += 0.03


    fraud_probability = min(
        fraud_probability,
        0.85,
    )


    target = rng.binomial(
        1,
        fraud_probability,
    )


    # --------------------------------------------------------
    # ГОТОВАЯ ТАБЛИЦА КОЛЛЕГ
    # --------------------------------------------------------

    existing_rows.append({

        "epk_id": epk_id,

        "reference_time":
            REFERENCE_TIME,

        "device_change_24h":
            device_change_24h,

        "transfer_count_1h":
            transfer_count_1h,

        "amount_sum_1h":
            amount_sum_1h,

        "client_age_days":
            client_age_days,

        "risk_score":
            risk_score,

        "target":
            target,
    })


# ============================================================
# 3. СОЗДАЁМ POLARS DATAFRAME
# ============================================================

events = pl.DataFrame(
    events_rows
)

existing = pl.DataFrame(
    existing_rows
)


print(
    "Количество событий:",
    events.height,
)

print(
    "Количество клиентов:",
    existing.height,
)

print(
    "Fraud клиентов:",
    existing
    .filter(
        pl.col("target") == 1
    )
